  "method": {
    "and": "minimum",
    "implication": "clipping at rule strength",
    "aggregation": "maximum",
    "defuzzification": "numerical centroid integral on 0.1 percentage-point grid"
  },
  "mapping": {
    "temperature": "S1_Temp",
    "light": "S1_Light",
    "co2": "S5_CO2"
  },
  "lighting_postprocessing": "If the supplied occupancy is exactly zero, force final lighting to 0; retain raw fuzzy centroid in trace.",
  "scope": "Illustrative static educational controller. Membership endpoints and rules are design assumptions, not learned, calibrated or regulatory limits. Outputs are requested levels, not measured power/airflow.",
  "rules": [
    {
      "id": "L01",
      "output": "lighting",
      "if": {
        "occupancy": "empty"
      },
      "then": "off"
    },
    {
      "id": "L02",
      "output": "lighting",
      "if": {
        "occupancy": "low",
        "light": "dark"
      },
      "then": "medium"
    },
    {
      "id": "L03",
      "output": "lighting",
      "if": {
        "occupancy": "low",
        "light": "adequate"
      },
      "then": "dim"
    },
    {
      "id": "L04",
      "output": "lighting",
      "if": {
        "occupancy": "low",
        "light": "bright"
      },
      "then": "off"
    },
    {
      "id": "L05",
      "output": "lighting",
      "if": {
        "occupancy": "high",
        "light": "dark"
      },
      "then": "high"
    },
    {
      "id": "L06",
      "output": "lighting",
      "if": {
        "occupancy": "high",
        "light": "adequate"
      },
      "then": "medium"
    },
    {
